<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 作用域页需要枚举已安装应用（Android 11+ 包可见性限制） -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
        libxposed 底座（YukiHook 1.5.0 + @YukiHookLibXposedEntry）：
        - 模块名/描述从 application 的 android:label / android:description 读取，
          不再使用 xposedmodule/xposeddescription 等 legacy meta-data；
        - 入口与 module.prop/scope.list/java_init.list 由 KSP(yukihook-compiler) 生成到
          META-INF/xposed/（源码目录不得手写这些文件，否则拒绝编译）；
        - 作用域 staticScope=false（注解默认），运行时经 XposedService requestScope/removeScope 动态管理，
          故此处不声明推荐作用域列表；
        - libxposed service 库自带的 XposedProvider（authorities=${applicationId}.XposedService）
          由 manifest merger 自动并入，框架经它向模块进程递送 XposedService Binder。
    -->
    <application
        android:name=".CaptureToPhotoPickerApplication"
        android:allowBackup="false"
        android:description="@string/module_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Module.Default">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
